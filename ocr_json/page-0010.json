{"w":7029,"h":11508,"lines":[{"h":0.01744185932098874,"text":"heb ich vereinsamt meine Hände","conf":1,"x":0.21140141686981684,"y":0.93750000039764514,"w":0.45605701595157777},{"w":0.44655579405945617,"text":"zu dir empor, zu dem ich fliehe,","y":0.91133720966689846,"x":0.2114014395973503,"h":0.023255813689458948,"conf":1},{"y":0.89236111106127103,"text":"dem ich in tiefster Herzenstiefe","x":0.21140142027336462,"w":0.4275534493582589,"conf":1,"h":0.019097222222222321},{"x":0.21377673192461716,"text":"Altäre feierlich geweiht,","conf":0.5,"y":0.8648255816192072,"w":0.33016625936929284,"h":0.02183116428435794},{"text":"dass allezeit","y":0.84548994703287783,"conf":1,"w":0.16414093661617921,"x":0.21127870150434627,"h":0.018322432798052679},{"w":0.44893111191786733,"text":"mich deine Stimme wieder riefe.","y":0.82266865089782792,"h":0.018901116318172817,"x":0.21140143225365543,"conf":1},{"x":0.19477433655811405,"w":0.48456058254489653,"y":0.78633720962813869,"h":0.023255813689458948,"text":"\"Darauf erglüht tief eingeschrieben","conf":1},{"w":0.49406175489549509,"conf":1,"text":"das Wort: dem unbekannten Gotte.","h":0.017609126984126977,"x":0.21140143070743841,"y":0.76736111093509152},{"text":"Sein bin ich, ob ich in der Frevler Rotte","conf":1,"x":0.2114014247240156,"y":0.73982558129480536,"h":0.023319259522453173,"w":0.55581947425743206},{"x":0.21140143395723221,"w":0.48218526468648537,"h":0.020354603964184981,"conf":1,"text":"auch bis zur Stunde bin geblieben:","y":0.71947674479244617},{"x":0.21111473727683819,"conf":1,"y":0.69459587891230545,"text":"sein bin ich—und ich fühl die Schlingen,","w":0.56610959536069405,"h":0.027021023962232715},{"text":"die mich im Kampf darniederziehn","w":0.48456058254489653,"h":0.018958794692205849,"conf":1,"y":0.67435515840678906,"x":0.21140142240247539},{"h":0.021917680899302128,"y":0.64970930284013739,"conf":1,"text":"und, mag ich fliehn,","w":0.28028503021636569,"x":0.21377672479680526},{"h":0.020406514879256932,"y":0.62790697684186481,"x":0.21140142743493603,"w":0.53444181169782368,"conf":1,"text":"mich doch zu seinem Dienste zwingen."},{"w":0.5171783249099533,"conf":1,"text":"\"Ich will dich kennen, Unbekannter,","h":0.033613212524898461,"y":0.58847117930746684,"x":0.18677337667638955},{"text":"du tief in meine Seele greifender,","y":0.57118055553355307,"h":0.020389211556268161,"w":0.45605701595157777,"conf":1,"x":0.21140142532587372},{"conf":1,"text":"mein Leben wie ein Sturm durchschweifender!","y":0.55232558184628855,"w":0.64370544235427651,"h":0.01744185932098874,"x":0.21140143022824581},{"conf":1,"x":0.21140144333536096,"y":0.52604166700520305,"w":0.4679334566190646,"h":0.021923449304368736,"text":"Du Unfassbarer, mir Verwandter!"},{"h":0.026507276391226076,"conf":1,"w":0.56820792656440244,"text":"Ich will dich kennen, selbst dir dienen.\"1","x":0.21118769318199254,"y":0.49985080240070412},{"y":0.46947674440990483,"w":0.81947742808948865,"h":0.021842700148385741,"text":"When man has ceased to build an altar to the unknown God,","conf":1,"x":0.11876485914409145},{"h":0.023313492063492092,"w":0.81947742808948854,"y":0.44766865062229699,"text":"he is unlikely any longer to acknowledge the revealed God,","x":0.11638954287330806,"conf":1},{"text":"the Lord of heaven and earth, for such a one wishes to","conf":1,"x":0.11401425326523196,"y":0.42286706327670476,"w":0.81947742808948854,"h":0.023353867114536353},{"x":0.11603459780839617,"conf":1,"w":0.33325200266652288,"text":"become his own master.","y":0.40396164654064382,"h":0.019133280193994961},{"x":0.2612826635335263,"y":0.37351190470336504,"conf":1,"w":0.32304038010634378,"text":"1 \"Once more, ere I travel on,","h":0.016121031746031744},{"x":0.28978622991568831,"h":0.017441860267094156,"y":0.3575581401277117,"text":"Straining forward eagerly,","conf":1,"w":0.2826603233040153},{"conf":1,"text":"In lonely wrestling, to Thee I lift my hands,","x":0.28978622677551408,"y":0.34151785688082903,"h":0.017609126984126977,"w":0.4703087744774756},{"w":0.1662707762284712,"conf":1,"x":0.2897862291660494,"y":0.32986111111877892,"h":0.014632936507936511,"text":"To Thee I flee."},{"conf":1,"y":0.31395348894415687,"h":0.01744185932098874,"w":0.33966745649065289,"x":0.28741092393994683,"text":"Thou, to whom in deepest faith"},{"text":"In solemn awe, I have hallowed altars,","x":0.29216152354295255,"y":0.30084325435079529,"w":0.41567695914924918,"h":0.02183116428435794,"conf":1},{"text":"That Thy voice may ever echo in my soul.","w":0.45368169809316666,"y":0.28633721025087455,"conf":1,"h":0.015994139133937768,"x":0.29216152985286231},{"conf":1,"text":"\"Thereon, deep engraved in letters of flame,","y":0.2616279074266834,"h":0.018895347913106209,"w":0.47268409233588676,"x":0.27790973924377466},{"conf":1,"x":0.28028505712995561,"w":0.4180522274661374,"y":0.25145348877691598,"h":0.013179447915818931,"text":"• Stands written: to the unknown God."},{"conf":1,"h":0.016121031746031744,"y":0.23536706348156256,"w":0.42517813149984784,"x":0.2921615227595773,"text":"His I am, e'en though in wanton shame"},{"w":0.3087885968096844,"conf":1,"x":0.29453681473846749,"y":0.22093023350668839,"h":0.015988370728871271,"text":"I tarried to the present hour:"},{"text":"His I am and I feel the snares","conf":1,"w":0.32066506224793273,"y":0.20930232622846645,"x":0.29216153099004788,"h":0.013167912051791242},{"text":"Which grip and twine and hold me low,","conf":1,"w":0.43266469782049005,"x":0.29198210500749838,"y":0.1888925769823826,"h":0.019179792631240145},{"y":0.17584325353487207,"conf":1,"text":"And-though fain I would flee-","x":0.29216152661477551,"w":0.35629453287496199,"h":0.017470699454110727},{"w":0.28503561639166497,"conf":1,"h":0.014632936507936511,"x":0.28978623265927428,"y":0.16269841250039063,"text":"Compel me to His service."},{"y":0.13803364950541497,"h":0.019038715059795042,"text":"\"Thou unknown God, Thee will I know,","conf":1,"x":0.27534942527809542,"w":0.44216012335442872},{"h":0.014534883082859107,"text":"Thou who piercest my heart,","y":0.12645348865479134,"x":0.29453682184456387,"w":0.3087885968096844,"conf":1},{"w":0.43942989002574573,"text":"And in stormy anger dost sweep my soul.","x":0.29453684378364309,"h":0.014632936507936511,"y":0.1118551586641513,"conf":1},{"text":"Inapprehensible, yet to me akin!","x":0.28978623439172579,"y":0.09593023238754872,"w":0.34916862884125155,"h":0.015988372621082103,"conf":1},{"x":0.28741091843250965,"w":0.4275534493582589,"conf":1,"y":0.079861111007765939,"h":0.017609126984126977,"text":"Thee will I know, Thyself will I serve.\""},{"y":0.056686046047743854,"conf":1,"x":0.50593824302951351,"h":0.015988372621082103,"text":"14","w":0.033254155864963386}],"page":10}