{"h":11508,"lines":[{"conf":1,"x":0.10193495680643166,"w":0.81750691401494002,"h":0.025057959178137357,"text":"thanks and praise to the Creator who stands as sovereign","y":0.93372575099741661},{"h":0.029820050512041396,"text":"Lord over His creation, and has declared: \"While the earth","conf":1,"x":0.10183933725027028,"y":0.90838882651269071,"w":0.81778979611087155},{"w":0.16431407185343952,"text":"remains...","y":0.89167686977527916,"x":0.10192847441312028,"h":0.01897184243277894,"conf":1},{"x":0.2565320669500043,"text":".\":","conf":0.5,"y":0.89389534837332518,"w":0.040380047513292994,"h":0.015988372621082214},{"text":"\"Wenige nur, ach wenige sind,","y":0.85465116263201479,"conf":1,"w":0.4275534493582589,"x":0.13064132490519365,"h":0.02332502792751967},{"w":0.40380046894023947,"text":"Deren Aug' in der Schöpfung","y":0.83283730136927825,"h":0.021825396825396859,"x":0.14964370743011782,"conf":1},{"x":0.14940342129143699,"w":0.53021289775897928,"y":0.80851248574924006,"h":0.0247073381666153,"text":"Den Schöpfer sieht! wenige deren Ohr","conf":1},{"h":0.026420298076811233,"text":"Ihn in dem mächtigen Rauschen des Sturmwinds hört,","y":0.78532764643539055,"x":0.14942574906636319,"w":0.75574438912527908,"conf":1},{"w":0.66085300197849028,"text":"Im Donner, der rollt, oder im lispelnden Bache,","x":0.1493819130405335,"h":0.027333384468441912,"y":0.76112140306886866,"conf":1},{"text":"Unerschaffener, Dich vernimmt!","x":0.15201901496552134,"y":0.7412790698277828,"w":0.44655579405945617,"h":0.02186577187644112,"conf":1},{"x":0.1496437069326309,"w":0.70071257554091426,"conf":1,"y":0.71947674421005026,"h":0.02184270014838563,"text":"Weniger Herzen erfüllt mit Ehrfurcht und Schauer"},{"y":0.69618055555777791,"conf":1,"x":0.14964371550829161,"h":0.020389211556268161,"text":"Gottes Allegegenwart.","w":0.30166269277597402},{"conf":1,"y":0.65988372115772465,"x":0.13064133185293694,"w":0.4275534493582589,"h":0.021911913440341046,"text":"\"Du, den Worte nicht nennen,"},{"h":0.020400747420295851,"conf":1,"text":"Deine noch ungeschaute Gegenwart","x":0.1496437118159103,"y":0.63808139578808576,"w":0.4940617548954952},{"text":"Erleucht' und erhebe jeden meiner Gedanken!","conf":1,"y":0.61627907023576012,"h":0.020377675692240471,"w":0.64133017403738846,"x":0.14964370799318222},{"h":0.021854236012413431,"y":0.59151785689962932,"x":0.14964370831636437,"w":0.444180525742568,"text":"Leit ihn, Unerschaffner, zu Dir!","conf":1},{"text":"Deiner Gottheit Gegenwart","conf":1,"x":0.14964371448580263,"w":0.37767219543457031,"y":0.56969246026112197,"h":0.020423818202245814},{"h":0.019097222222222321,"conf":1,"y":0.54786706338871816,"text":"Entflamm' und beflügle","x":0.15201900751226691,"w":0.32541567319399345},{"y":0.5247093028401375,"w":0.39429927181887936,"h":0.021917680899302128,"x":0.14726842091953887,"conf":1,"text":"Jede meiner Empfindungen!"},{"text":"Leit sie, Unerschaffner, zu Dir!","conf":1,"x":0.14964372352014488,"y":0.49999999984131704,"w":0.4346793038504464,"h":0.023313492063492092},{"text":"Wer bin ich, o Erster!","w":0.30641330372203479,"y":0.47817460275089019,"conf":1,"x":0.14964370480960812,"h":0.021825396825396859},{"y":0.45930232608078458,"h":0.01744185932098874,"w":0.24465558436009793,"x":0.15201899964002236,"text":"Und wer bist Du!","conf":1},{"y":0.43168604693434032,"x":0.14964370952870068,"w":0.41567695914924918,"h":0.023255813689458948,"conf":0.5,"text":"Stärke, kräftige, gründe mich,"},{"w":0.40142517585258986,"x":0.14726841038724425,"y":0.41133720945087648,"text":"Dass ich auf ewig Dein sei!\"1","conf":1,"h":0.020458425794328994},{"w":0.6057007034103592,"h":0.01909722222222221,"conf":1,"text":"1 Klopstock, Dem Allgegenwärligen (To the Omnipresent) :","y":0.38070436537123209,"x":0.20190023781382291},{"h":0.014000943728855741,"text":"\"How few there are, how few","conf":1,"y":0.35963754518055058,"x":0.18978529711817835,"w":0.31159552041586336},{"conf":1,"text":"Whose eye pierces the veil of creatior","y":0.34352035962048999,"w":0.38749833540482959,"x":0.20174023782437178,"h":0.016199533901517293},{"conf":1,"y":0.32986111121325556,"h":0.014632936507936511,"text":"To behold the Creator! whose ear hears Him","x":0.19952494580378938,"w":0.47743467851118609},{"conf":1,"x":0.19714963953725903,"y":0.31395348887148244,"w":0.43230403553355823,"h":0.01744185932098874,"text":"In the mighty roar of wind and tempest,"},{"conf":1,"w":0.54869357022372167,"h":0.01909722222222221,"y":0.29786706350499736,"x":0.19952494450809183,"text":"Who in the rolling thunder or the whispering brook"},{"conf":1,"y":0.28488372076794721,"w":0.41330166606159957,"h":0.015988372621082214,"x":0.1995249430737133,"text":"Can hear Thy voice, Thou Uncreated!"},{"y":0.26884920596427397,"x":0.20190024823886563,"conf":1,"text":"Few there are whose hearts are filled with awe and adoration","h":0.018941491369217189,"w":0.64608076021268757},{"text":"By him whose presence moves and breathes in all things!","h":0.016121031746031744,"y":0.25719245984490791,"x":0.19952494813851546,"w":0.60332538555194803,"conf":1},{"y":0.23240775991611251,"conf":1,"w":0.38779261205103499,"text":"\"Thou whom words may not name,","h":0.017990195561969013,"x":0.18496655203951243},{"x":0.20190023883213218,"text":"May Thy yet unseen presence","y":0.21947674474733014,"conf":1,"h":0.014650239357872574,"w":0.31353918298498373},{"w":0.41330166606159957,"conf":1,"y":0.2033730160000774,"h":0.017609126984126977,"text":"Inspire and inflame my every thought!","x":0.19952494189285144},{"x":0.20427554806347187,"conf":1,"text":"Guide my mind to Thy uncreated wisdom!","w":0.45368169809316655,"h":0.010284007068664391,"y":0.19320436496946336},{"h":0.013144841269841168,"conf":1,"y":0.17584325384674016,"text":"May Thy divinity kindle all my feelings","w":0.41805222746613735,"x":0.20190025728830882},{"h":0.015988372621082103,"x":0.19952494608173765,"text":"That they may soar aloft to feel and find Thee!","conf":1,"y":0.15988372061429279,"w":0.50356292724609375},{"w":0.28028503021636564,"conf":1,"text":"Primal Creator, who am I","h":0.017453396131121957,"x":0.19952494099633034,"y":0.14533730114565147},{"text":"And who art Thou, ineffable One?","conf":1,"x":0.19952494408770416,"y":0.13070436494574933,"h":0.017609126984126977,"w":0.37292160925927098},{"x":0.19952494826868392,"w":0.59382421320134937,"h":0.018895347913106209,"conf":1,"text":"Strengthen and uphold me with Thine enfolding might,","y":0.11482558209359228},{"x":0.20190024226140343,"conf":1,"y":0.10317460363909803,"text":"That I may be for ever Thine!\"","w":0.33966745649065289,"h":0.016121031746031744},{"text":"50","w":0.035629452048958121,"h":0.014534883082859107,"conf":1,"y":0.072674418814675179,"x":0.48931116426649485}],"page":46,"w":7029}